---
import type { Category, Tool } from '../lib/schema';
import { getCategoryTheme } from '../lib/theme';
import ToolCard from './ToolCard.astro';

interface Props {
  category: Category;
  tools: Tool[];
  index: number;
}

const { category, tools, index } = Astro.props;
const theme = getCategoryTheme(category.id);
---

<section id={category.id} class="scroll-mt-24">
  <div class="flex gap-5">
    <div
      class:list={['mt-3 hidden w-[3px] shrink-0 self-stretch rounded-full md:block', theme.rail]}
      aria-hidden="true"
    >
    </div>

    <div class="min-w-0 flex-1">
      <header class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-display text-sm tracking-[0.16em] text-muted">
            {String(index + 1).padStart(2, '0')}
          </p>
          <h2 class="font-display mt-1 text-3xl tracking-tight text-ink md:text-4xl">
            {category.name}
          </h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-muted">{category.description}</p>
      </header>

      {
        tools.length === 0 ? (
          <p class="py-6 text-sm text-muted">该分类暂无工具。</p>
        ) : (
          <div class="grid gap-4 md:grid-cols-2">
            {tools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
