---
import type { Tool } from '../lib/schema';
import { accessLabel } from '../lib/labels';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.slug}`}
  class="group grid grid-cols-[1fr_auto] items-start gap-4 border-b border-line/80 px-1 py-5 no-underline transition duration-300 hover:bg-surface/80 hover:px-3 md:grid-cols-[minmax(0,14rem)_1fr_auto] md:items-center"
>
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-base font-semibold tracking-tight text-ink transition group-hover:text-accent-deep md:text-lg">
        {tool.name}
      </h3>
      <span
        class:list={[
          'rounded-full px-2 py-0.5 text-[0.65rem] font-medium tracking-wide',
          tool.access === 'web' && 'bg-accent-soft text-accent-deep',
          tool.access === 'client' && 'bg-paper-deep text-ink-soft',
          tool.access === 'api-key' && 'bg-[#e8f0ec] text-accent-deep',
        ]}
      >
        {accessLabel[tool.access]}
      </span>
    </div>
    {
      tool.tags.length > 0 && (
        <p class="mt-1 text-xs text-muted md:hidden">{tool.tags.join(' · ')}</p>
      )
    }
  </div>

  <p class="col-span-2 text-sm leading-relaxed text-ink-soft md:col-span-1 md:col-start-2">
    {tool.summary}
  </p>

  <span
    class="col-start-2 row-start-1 self-center text-sm text-accent opacity-0 transition duration-300 group-hover:translate-x-0.5 group-hover:opacity-100 md:col-start-3 md:row-start-auto"
    aria-hidden="true"
  >
    查看 →
  </span>
</a>
