---
import { getSite } from '../lib/tools';

const site = getSite();
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-surface/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3 md:px-8">
    <a href="/" class="group min-w-0 no-underline">
      <span class="font-display block text-[1.2rem] leading-none tracking-tight text-ink transition group-hover:text-accent md:text-[1.35rem]">
        {site.name}
      </span>
      <span class="mt-1 block text-[0.65rem] font-medium tracking-[0.16em] text-muted uppercase">
        {site.nameEn}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      <a
        href="/#tools"
        class:list={[
          'rounded-md px-3 py-2 text-sm transition hover:text-accent-deep',
          path === '/' ? 'text-accent-deep' : 'text-ink-soft',
        ]}
      >
        工具目录
      </a>
      <a
        href="/about"
        class:list={[
          'rounded-md px-3 py-2 text-sm transition hover:text-accent-deep',
          path.startsWith('/about') ? 'text-accent-deep' : 'text-ink-soft',
        ]}
      >
        关于
      </a>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-lg border border-line bg-surface p-2 text-ink-soft [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">菜单</span>
        <span class="flex h-4 w-4 flex-col justify-center gap-1" aria-hidden="true">
          <span class="block h-px w-4 bg-ink transition group-open:translate-y-[2.5px] group-open:rotate-45"></span>
          <span class="block h-px w-4 bg-ink transition group-open:-translate-y-[2.5px] group-open:-rotate-45"></span>
        </span>
      </summary>
      <div class="absolute right-0 mt-2 w-44 rounded-xl border border-line bg-surface p-2 shadow-lg">
        <a href="/#tools" class="block rounded-md px-3 py-2 text-sm no-underline hover:bg-paper-deep">工具目录</a>
        <a href="/about" class="block rounded-md px-3 py-2 text-sm no-underline hover:bg-paper-deep">关于</a>
      </div>
    </details>
  </div>
</header>
