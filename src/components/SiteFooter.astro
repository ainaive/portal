---
import { getSite } from '../lib/tools';

const site = getSite();
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line/80">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-10 text-sm text-muted md:flex-row md:items-end md:justify-between md:px-8">
    <div>
      <p class="font-display text-lg text-ink">{site.name}</p>
      <p class="mt-1 tracking-wide">{site.nameEn}</p>
    </div>
    <p>© {year} · 静态目录站 · 数据来自仓库 YAML</p>
  </div>
</footer>
