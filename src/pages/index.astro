---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategorySection from '../components/CategorySection.astro';
import { getSite, getTools, getToolsByCategory } from '../lib/tools';

const site = getSite();
const groups = getToolsByCategory();
const toolCount = getTools().length;
---

<BaseLayout>
  <div class="mx-auto max-w-6xl px-5 pt-10 md:px-8 md:pt-14">
    <div class="reveal grid gap-8 border-b border-line/80 pb-10 md:grid-cols-[1.2fr_0.8fr] md:items-end md:pb-12">
      <div>
        <p class="text-xs font-medium tracking-[0.22em] text-accent uppercase">
          {site.nameEn}
        </p>
        <h1 class="font-display mt-3 text-4xl leading-[1.1] tracking-tight text-ink md:text-5xl lg:text-[3.4rem]">
          {site.name}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft md:text-lg">
          {site.tagline}
        </p>
      </div>

      <div class="reveal reveal-delay-1 rounded-xl border border-line/80 bg-surface/70 p-5 md:justify-self-end md:p-6">
        <p class="text-sm text-muted">目录收录</p>
        <p class="font-display mt-2 text-4xl text-accent-deep">{toolCount}</p>
        <p class="mt-1 text-sm text-ink-soft">个工具 · {groups.length} 个分类</p>
        <a
          href="#tools"
          class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent no-underline transition hover:text-accent-deep"
        >
          浏览分类
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <nav
      id="tools"
      class="reveal reveal-delay-2 sticky top-[4.25rem] z-30 -mx-5 mb-12 overflow-x-auto border-b border-line/60 bg-paper/90 px-5 py-3 backdrop-blur-md md:-mx-8 md:px-8"
      aria-label="分类导航"
    >
      <ul class="flex min-w-max gap-2">
        {
          groups.map(({ category, tools }) => (
            <li>
              <a
                href={`#${category.id}`}
                class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3.5 py-1.5 text-sm text-ink-soft no-underline transition hover:border-accent/40 hover:bg-accent-soft/70 hover:text-accent-deep"
              >
                <span>{category.name}</span>
                <span class="text-xs text-muted">{tools.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col gap-16 pb-8 md:gap-20">
      {
        groups.map(({ category, tools }, index) => (
          <CategorySection category={category} tools={tools} index={index} />
        ))
      }
    </div>
  </div>
</BaseLayout>
