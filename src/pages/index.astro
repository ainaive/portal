---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategorySection from '../components/CategorySection.astro';
import { getCategoryTheme } from '../lib/theme';
import { getSite, getTools, getToolsByCategory } from '../lib/tools';

const site = getSite();
const groups = getToolsByCategory();
const toolCount = getTools().length;
---

<BaseLayout>
  <div class="mx-auto max-w-6xl px-5 pt-14 md:px-8 md:pt-20">
    <header class="reveal max-w-3xl border-b border-line/80 pb-10 md:pb-12">
      <p class="text-xs font-medium tracking-[0.2em] text-accent uppercase">工具目录</p>
      <h1 class="font-display mt-4 text-3xl leading-tight tracking-tight text-ink text-balance md:text-4xl lg:text-[2.75rem]">
        {site.tagline}
      </h1>
      <p class="mt-5 text-sm text-muted">
        {toolCount} 个工具 · {groups.length} 个分类
      </p>
      <nav id="tools" class="mt-8" aria-label="分类导航">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {
            groups.map(({ category, tools }) => (
              <li>
                <a
                  href={`#${category.id}`}
                  class="inline-flex items-center gap-2 text-sm font-medium text-ink no-underline transition hover:text-accent-deep"
                >
                  <span
                    class:list={['h-1.5 w-1.5 rounded-full', getCategoryTheme(category.id).dot]}
                    aria-hidden="true"
                  />
                  <span>{category.name}</span>
                  <span class="font-normal text-muted">{tools.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <div class="flex flex-col gap-20 pb-8 md:gap-28">
      {
        groups.map(({ category, tools }, index) => (
          <CategorySection category={category} tools={tools} index={index} />
        ))
      }
    </div>
  </div>
</BaseLayout>
